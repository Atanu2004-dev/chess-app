<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
    <style>
        .chessboard {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    width: 400px;
    height: 400px;
    border: 4px solid #3b2a1a;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

.square {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.square.light {
    background-color: #f0d9b5;
}

.square.dark {
    background-color: #b58863;
}

.piece {
    font-size: 1.75rem; /* was 2.5rem */
    cursor: grab;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transition: transform 0.15s ease;
}

.piece:active {
    cursor: grabbing;
}

.piece.white {
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.piece.black {
    color: #1a1a1a;
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.3);
}

.square.dragover {
    outline: 3px solid #4ade80;
    outline-offset: -3px;
}
.piece {
    font-family: "Segoe UI Symbol", "Noto Sans Symbols2", "DejaVu Sans", sans-serif;
    font-variant-emoji: text; /* stops browsers rendering it as a colorful emoji */
}
    </style>
</head>
<body>

    <div class="w-full h-screen flex items-center justify-center bg-zinc-900">
        <div class=" chessboard w-96 h-96 bg-red-400"></div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js" integrity="sha512-xRllwz2gdZciIB+AkEbeq+gVhX8VB8XsfqeFbUh+SzHlN96dEduwtTuVuc2u9EROlmW9+yhRlxjif66ORpsgVA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="/js/chasegame.js"></script>

</body>
</html>